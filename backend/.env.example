# Copy to .env and replace every secret before deployment
JAL_JWT_SECRET=replace-with-a-long-random-secret
JAL_ADMIN_PASSWORD=replace-admin-password
JAL_OFFICE_PASSWORD=replace-office-password
JAL_FIELD_PASSWORD=replace-field-password
JAL_DB_PATH=./jal_drishiti.sqlite3
JAL_UPLOADS_PATH=./uploads
JAL_TOKEN_HOURS=8
# Comma-separated browser origins in the deployment environment
JAL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://your-app.vercel.app
JAL_CORS_ORIGIN_REGEX=https://[a-zA-Z0-9-]+\.vercel\.app
